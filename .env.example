# Copy to .env (or set in your shell) — all optional.

# Who writes the conversations:
#   free   (default) a free public AI (Pollinations): no account, no key, no cost
#   claude Claude, with ANTHROPIC_API_KEY below and the budget limits
#   off    the built-in AI only (nothing leaves your machine)
AI_PROVIDER=free

# Free AI endpoint (any keyless OpenAI-style chat endpoint) and the minimum gap between calls.
# FREE_AI_URL=https://text.pollinations.ai/openai
# FREE_AI_INTERVAL_MS=4000

# Claude (only with AI_PROVIDER=claude).
ANTHROPIC_API_KEY=

# Which model. Claude: voices the big decisions/conversations.
# Default: claude-opus-5-5 ($4/$20 per million tokens). claude-haiku-4-5 is
# about 4x cheaper per token if you want to stretch your budget further.
# Free AI: the Pollinations model name (default "openai").
# AI_MODEL=claude-opus-5-5

# Hard cap on lifetime Claude spend in US dollars (tracked in data/hustle.db).
AI_BUDGET_USD=2

# Max AI calls per game day (default 12 for Claude, 5000 for the free AI).
# AI_MAX_CALLS_PER_DAY=12

# Server port, data folder, autosave interval.
PORT=3000
DATA_DIR=./data
AUTOSAVE_SECONDS=30

# Start a specific world (ignores the saved one). Same seed = same story (with the AI off).
# SEED=42
