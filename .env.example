# Copy to .env (or set in your shell) — all optional.

# Who writes the conversations:
#   free   (default) a free public AI (Pollinations): no account, no key, no cost
#   claude Claude, with ANTHROPIC_API_KEY below and the budget limits
#   off    the built-in AI only (nothing leaves your machine)
AI_PROVIDER=free

# Free AI: by default several free services are tried in turn (Pollinations, LLM7, ...).
# FREE_AI_URL pins one OpenAI-style chat endpoint instead; FREE_AI_INTERVAL_MS is the gap between calls.
# FREE_AI_URL=https://text.pollinations.ai/openai
# FREE_AI_INTERVAL_MS=2500
#
# Your own model, local or hosted, through any OpenAI-compatible chat endpoint
# (keep AI_PROVIDER=free; set the full /chat/completions URL and the model name):
#   Ollama:     FREE_AI_URL=http://localhost:11434/v1/chat/completions  AI_MODEL=llama3.1
#   LM Studio:  FREE_AI_URL=http://localhost:1234/v1/chat/completions   AI_MODEL=<the loaded model>
#   Hosted:     FREE_AI_URL=https://<provider>/v1/chat/completions      AI_MODEL=<model>  FREE_AI_KEY=<key>
# FREE_AI_KEY=

# Only the AI speaks: no built-in lines at all. A conversation happens only if the AI
# speaks it; a line it gets wrong is asked for again; if it stops, the chat ends there.
# AI_ONLY=1
# How many conversations the AI speaks at once (unset: a couple; 20: the whole town),
# and how many requests it sends at once (match OLLAMA_NUM_PARALLEL for Ollama).
# AI_LIVE_CHATS=20
# AI_CONCURRENCY=4
# The best setup for a town where only the AIs talk (a local model on a graphics card):
#   OLLAMA_NUM_PARALLEL=4 ollama serve
#   AI_PROVIDER=free FREE_AI_URL=http://localhost:11434/v1/chat/completions AI_MODEL=qwen2.5:7b
#   FREE_AI_INTERVAL_MS=0 AI_CONCURRENCY=4 AI_LIVE_CHATS=20 AI_ONLY=1

# Claude (only with AI_PROVIDER=claude).
ANTHROPIC_API_KEY=

# Which model. Claude: voices the big decisions/conversations.
# Default: claude-opus-5-5 ($4/$20 per million tokens). claude-haiku-4-5 is
# about 4x cheaper per token if you want to stretch your budget further.
# Free AI: the Pollinations model name (default "openai").
# AI_MODEL=claude-opus-5-5

# Hard cap on lifetime Claude spend in US dollars (tracked in data/hustle.db).
AI_BUDGET_USD=2

# Max AI calls per game day (default 12 for Claude, 5000 for the free AI).
# AI_MAX_CALLS_PER_DAY=12

# Server port, data folder, autosave interval.
PORT=3000
DATA_DIR=./data
AUTOSAVE_SECONDS=30

# Start a specific world (ignores the saved one). Same seed = same story (with the AI off).
# SEED=42
